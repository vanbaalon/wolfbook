{
	"name": "wolfbook",
	"displayName": "Wolfbook — Wolfram Language Notebook",
	"description": "Interactive Wolfram Language notebook for VS Code. WSTP-backed kernel, MathML/SVG/PNG rendering, Unicode input, LSP diagnostics, and output expansion controls.",
	"publisher": "wolfbook",
	"version": "2.1.0",
	"engines": {
		"vscode": "^1.95.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/vanbaalon/wolfbook.git"
	},
	"keywords": [
		"wolfram",
		"mathematica",
		"notebook",
		"wstp",
		"wolframscript",
		"notebookRenderer"
	],
	"categories": [
		"Programming Languages",
		"Notebooks",
		"Other"
	],
	"galleryBanner": {
		"color": "#CC3333",
		"theme": "dark"
	},
	"activationEvents": [
		"onLanguage:wolfram",
		"onCommand:wolfram.OpenNotebook",
		"onCommand:wolfram.DownloadWolframEngine",
		"onCommand:createWolframScriptTerminal",
		"onCommand:wolfram.openConfigurations",
		"onCommand:wolfram.launchKernel"
	],
	"main": "./out/extension/extension.js",
	"icon": "images/icon.png",
	"contributes": {
		"languages": [
			{
				"id": "wolfram",
				"aliases": [
					"Wolfram",
					"wolfram",
					"Wolfram Language"
				],
				"extensions": [
					".wl",
					".m",
					".wls",
					".wlt",
					".mt",
					".vsnb",
					".evsnb",
					".wb"
				],
				"configuration": "./wolfram.language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "wolfram",
				"scopeName": "source.wolfram",
				"path": "./syntaxes/wolfram.tmLanguage.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Wolfram",
			"properties": {
				"wolfram.evalMode": {
					"scope": "workspace",
					"type": "string",
					"enum": [
						"auto",
						"advance",
						"refine"
					],
					"default": "auto",
					"enumDescriptions": [
						"Auto-detect: changed cells use Refine mode, unchanged cells use Advance mode",
						"Always advance: scroll to output and move focus to next cell after every evaluation",
						"Always refine: no scroll, no focus change — stay on the same cell in edit mode"
					],
					"description": "Post-evaluation scroll and focus behaviour. Auto detects whether the cell changed since last run.",
					"order": 0
				},
				"wolfram.lsp.serverEnabled": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"description": "Enables the Wolfram LSP server",
					"order": 1
				},
				"wolfram.notebook.kernelEnabled": {
					"scope": "resource",
					"type": "boolean",
					"default": false,
					"description": "Enables Notebook Evaluation",
					"order": 1
				},
				"wolfram.editor.autoReplaceUnicode": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"description": "Automatically replace \\[Name] with Unicode characters as you type",
					"order": 1
				},
				"wolfram.timeout_warning_enabled": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"description": "Enables the timeout warning if the kernel does not start after 15 seconds",
					"order": 2
				},
				"wolfram.systemKernel": {
					"scope": "user",
					"type": "string",
					"default": "Automatic",
					"description": "Path to Wolfram System kernel",
					"order": 0
				},
				"wolfram.advanced.lsp.ServerLogDirectory": {
					"scope": "user",
					"type": "string",
					"default": "Off",
					"description": "Directory for the Wolfram LSP server log",
					"order": 5
				},
				"wolfram.advanced.notebook.logDirectory": {
					"scope": "user",
					"type": "string",
					"default": "Off",
					"description": "Directory for the notebook log",
					"order": 5
				},
				"wolfram.advanced.lsp.command": {
					"scope": "user",
					"type": "array",
					"default": [
						"lspKernel"
					],
					"description": "Command to start the Wolfram LSP server",
					"order": 5
				},
				"wolfram.lsp.implicitTokens": {
					"scope": "user",
					"type": "array",
					"default": [],
					"description": "Experimental option for the Wolfram LSP server",
					"order": 3
				},
				"wolfram.lsp.semanticTokens": {
					"scope": "user",
					"type": "boolean",
					"default": false,
					"description": "Experimental option for the Wolfram LSP server",
					"order": 3
				},
				"wolfram.lsp.ignoreUnicodeCharacters": {
					"scope": "user",
					"type": "boolean",
					"default": true,
					"description": "Ignore Unicode characters in LSP diagnostics (e.g., Greek letters like α, β, γ)",
					"order": 3
				},
				"wolfram.notebook.rendering.invertBrightnessInDarkThemes": {
					"type": "boolean",
					"default": true,
					"description": "When an expression is evaluated, this option specifies whether the brightness of the images in the output should be inverted in dark and high contrast themes. ",
					"order": 4
				},
				"wolfram.notebook.rendering.imageScalingFactor": {
					"type": "number",
					"default": 0.8,
					"description": "Controls image output size",
					"order": 4
				},
				"wolfram.notebook.rendering.outputFormat": {
					"type": "string",
					"enum": [
						"Image",
						"HTML",
						"MathML",
						"InputForm"
					],
					"default": "Image",
					"enumDescriptions": [
						"PNG image (default, compatible with all outputs)",
						"Genuine HTML export like Wolfram Cloud",
						"MathML for native mathematical notation",
						"Plain text InputForm (flattened boxes)"
					],
					"description": "Output rendering format",
					"order": 4
				},
				"wolfram.notebook.textOutput.pageWidth": {
					"type": "integer",
					"default": 100,
					"minimum": 40,
					"description": "Maximum line width when exporting notebook output to a text (.wls) file via 'Open as text'",
					"order": 5
				},
				"wolfram.notebook.print.pageWidth": {
					"type": "integer",
					"default": 156,
					"minimum": 40,
					"description": "Kernel $PageWidth for Print[] output (characters per line). Default 156 = 2× the Mathematica default of 78.",
					"order": 6
				},
				"wolfram.notebook.customCSS": {
					"type": "object",
					"default": {},
					"description": "Custom CSS settings for notebooks",
					"properties": {
						"backgroundColor": {
							"type": "string",
							"description": "Background color for notebook cells"
						}
					},
					"order": 5
				}
			}
		},
		"semanticTokenTypes": [],
		"semanticTokenModifiers": [
			{
				"id": "Module",
				"description": "Annotates a variable that is Module scoped"
			},
			{
				"id": "Block",
				"description": "Annotates a variable that is Block scoped"
			},
			{
				"id": "With",
				"description": "Annotates a constant that is With scoped"
			},
			{
				"id": "shadowed",
				"description": "Annotates a variable, parameter, or constant that is shadowed"
			},
			{
				"id": "unused",
				"description": "Annotates a variable, parameter, or constant that is unused"
			},
			{
				"id": "error",
				"description": "Annotates a scoping error"
			}
		],
		"themes": [
			{
				"label": "Wolfram (Dark)",
				"uiTheme": "vs-dark",
				"path": "./themes/wolfram-dark.json"
			},
			{
				"label": "Wolfram (Default)",
				"uiTheme": "vs",
				"path": "./themes/wolfram-Default.json"
			},
			{
				"label": "Wolfram (Dark Rainbow)",
				"uiTheme": "vs-dark",
				"path": "./themes/wolfram-dark-rainbow.json"
			},
			{
				"label": "Wolfram (Light)",
				"uiTheme": "vs",
				"path": "./themes/Wolfram-light.json"
			}
		],
		"commands": [
			{
				"command": "wolfram.OpenNotebook",
				"title": "Open in System Editor"
			},
			{
				"command": "wolfram.registerFileTypes",
				"title": "Wolfbook: Register .wb / .evsnb / .vsnb File Types with Finder (macOS)"
			},
			{
				"command": "wolfram.DownloadWolframEngine",
				"title": "Wolfram Language: Download Wolfram Engine"
			},
			{
				"command": "createWolframScriptTerminal",
				"title": "Wolfram Language: Start Wolfram in Terminal"
			},
			{
				"command": "wolfram.launchKernel",
				"title": "Wolfram Language: Launch Default Kernel"
			},
			{
				"command": "wolfram.openConfigurations",
				"title": "Wolfram Language: Open Configurations"
			},
			{
				"command": "wolfram.abortEvaluation",
				"title": "Abort",
				"icon": "$(debug-stop)"
			},
			{
				"command": "wolfram.openDialogSubsession",
				"title": "Wolfram: Open Dialog Subsession on Live Kernel"
			},
			{
				"command": "wolfram.restartKernel",
				"title": "Restart",
				"icon": "$(debug-restart)"
			},
			{
				"command": "wolfram.convertToUnicode",
				"title": "Wolfram Language: Convert Selection to Unicode"
			},
			{
				"command": "wolfram.setOutputFormatImage",
				"title": "Output: Image (PNG)",
				"icon": "$(file-media)"
			},
			{
				"command": "wolfram.setOutputFormatHTML",
				"title": "Output: HTML",
				"icon": "$(symbol-color)"
			},
			{
				"command": "wolfram.setOutputFormatMathML",
				"title": "Output: MathML",
				"icon": "$(symbol-misc)"
			},
			{
				"command": "wolfram.setOutputFormatInputForm",
				"title": "Output: InputForm",
				"icon": "$(symbol-text)"
			},
			{
				"command": "wolfram.notebookSettings",
				"title": "Notebook Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "wolfram.clearCellOutput",
				"title": "Clear Output",
				"icon": "$(clear-all)"
			},
			{
				"command": "wolfram.expandTruncatedOutput",
				"title": "Expand Truncated Output",
				"icon": "$(unfold)"
			},
			{
				"command": "wolfram.executeCell",
				"title": "Wolfram: Execute Cell"
			},
			{
				"command": "wolfram.pasteImageCell",
				"title": "Wolfram: Paste Image as Cell (with prompt)",
				"icon": "$(file-media)"
			},
			{
				"command": "wolfram.pasteImageCellBelow",
				"title": "Paste Image as Cell",
				"icon": "$(file-media)"
			},
			{
				"command": "wolfram.evalMode.auto",
				"title": "Eval: Auto",
				"icon": "$(symbol-misc)"
			},
			{
				"command": "wolfram.evalMode.advance",
				"title": "Eval: Advance",
				"icon": "$(arrow-down)"
			},
			{
				"command": "wolfram.evalMode.refine",
				"title": "Eval: Refine",
				"icon": "$(sync)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"when": "resourceExtname == .nb || resourceExtname == .m || resourceExtname == .wl || resourceExtname == .wls || resourceExtname == .cdf",
					"command": "wolfram.OpenNotebook",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"when": "resourceExtname == .nb || resourceExtname == .m || resourceExtname == .wl || resourceExtname == .wls || resourceExtname == .cdf",
					"command": "wolfram.OpenNotebook",
					"group": "navigation"
				},
				{
					"when": "resourceExtname == .nb || resourceExtname == .m || resourceExtname == .wl || resourceExtname == .wls || resourceExtname == .cdf",
					"command": "workbench.action.terminal.runSelectedText",
					"group": "navigation"
				},
				{
					"when": "resourceExtname == .nb || resourceExtname == .m || resourceExtname == .wl || resourceExtname == .wls || resourceExtname == .cdf",
					"command": "workbench.action.terminal.runActiveFile",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "wolfram.OpenNotebook",
					"when": "false"
				},
				{
					"command": "wolfram.DownloadWolframEngine"
				}
			],
			"notebook/toolbar": [
				{
					"command": "wolfram.evalMode.auto",
					"when": "notebookType == extended-wolfram-notebook && wolframEvalMode == 'auto'",
					"group": "wolframMode@1"
				},
				{
					"command": "wolfram.evalMode.advance",
					"when": "notebookType == extended-wolfram-notebook && wolframEvalMode == 'advance'",
					"group": "wolframMode@1"
				},
				{
					"command": "wolfram.evalMode.refine",
					"when": "notebookType == extended-wolfram-notebook && wolframEvalMode == 'refine'",
					"group": "wolframMode@1"
				},
				{
					"command": "wolfram.abortEvaluation",
					"when": "(notebookType == wolfram-notebook || notebookType == extended-wolfram-notebook) && wolframKernelActive",
					"group": "navigation@-2"
				},
				{
					"command": "wolfram.restartKernel",
					"when": "(notebookType == wolfram-notebook || notebookType == extended-wolfram-notebook) && wolframKernelActive",
					"group": "navigation@-1"
				},
				{
					"command": "wolfram.setOutputFormatImage",
					"when": "notebookType == extended-wolfram-notebook && config.wolfram.notebook.rendering.outputFormat != 'Image'",
					"group": "wolframOutput@1"
				},
				{
					"command": "wolfram.setOutputFormatHTML",
					"when": "notebookType == extended-wolfram-notebook && config.wolfram.notebook.rendering.outputFormat != 'HTML'",
					"group": "wolframOutput@2"
				},
				{
					"command": "wolfram.setOutputFormatMathML",
					"when": "notebookType == extended-wolfram-notebook && config.wolfram.notebook.rendering.outputFormat != 'MathML'",
					"group": "wolframOutput@3"
				},
				{
					"command": "wolfram.setOutputFormatInputForm",
					"when": "notebookType == extended-wolfram-notebook && config.wolfram.notebook.rendering.outputFormat != 'InputForm'",
					"group": "wolframOutput@4"
				},
				{
					"command": "wolfram.notebookSettings",
					"when": "notebookType == extended-wolfram-notebook",
					"group": "navigation@10"
				}
			],
			"notebook/cell/title": [
				{
					"command": "wolfram.clearCellOutput",
					"when": "notebookType == extended-wolfram-notebook && notebookCellHasOutputs",
					"group": "inline@1"
				},
				{
					"command": "wolfram.expandTruncatedOutput",
					"when": "notebookType == extended-wolfram-notebook && notebookCellHasOutputs",
					"group": "inline@2"
				}
			],
			"notebook/cell/between": [
				{
					"command": "wolfram.pasteImageCellBelow",
					"when": "notebookType == extended-wolfram-notebook",
					"group": "navigation"
				}
			]
		},
		"keybindings": [
			{
				"command": "wolfram.pasteImageCellBelow",
				"key": "ctrl+v",
				"mac": "cmd+v",
				"when": "notebookEditorFocused && !editorTextFocus && notebookType == 'extended-wolfram-notebook'"
			},
			{
				"command": "wolfram.pasteImageCell",
				"key": "ctrl+shift+v",
				"mac": "cmd+shift+v",
				"when": "notebookEditorFocused && notebookType == 'extended-wolfram-notebook'"
			},
			{
				"command": "wolfram.abortEvaluation",
				"key": "cmd+.",
				"when": "notebookEditorFocused && notebookType == 'extended-wolfram-notebook'"
			},
			{
				"command": "wolfram.openDialogSubsession",
				"key": "alt+shift+enter",
				"when": "notebookEditorFocused && notebookType == 'extended-wolfram-notebook'"
			},
			{
				"command": "wolfram.executeCell",
				"key": "shift+enter",
				"when": "notebookEditorFocused && !notebookEditorTabFocused && notebookType == 'extended-wolfram-notebook'"
			},
			{
				"command": "workbench.action.terminal.runSelectedText",
				"key": "Shift+Enter",
				"when": "resourceExtname == .nb || resourceExtname == .m || resourceExtname == .wl || resourceExtname == .wls || resourceExtname == .cdf"
			}
		],
		"notebooks": [
			{
				"type": "extended-wolfram-notebook",
				"displayName": "Extended Wolfram Notebook",
				"selector": [
					{
						"filenamePattern": "*.evsnb"
					},
					{
						"filenamePattern": "*.vsnb"
					},
					{
						"filenamePattern": "*.wb"
					}
				],
				"priority": "default"
			}
		],
		"iconThemes": [
			{
				"id": "wolfbook-file-icons",
				"label": "Wolfbook File Icons",
				"path": "./icons/wolfbook-icon-theme.json"
			}
		],
		"notebookRenderer": [
			{
				"id": "wolfram-notebook-renderer",
				"entrypoint": "./out/client/index-with-messaging.js",
				"displayName": "wolfram-notebook-renderer",
				"mimeTypes": [
					"x-application/wolfram-language-html"
				],
				"dependencies": [],
				"requiresMessaging": "optional"
			}
		],
		"languageModelTools": [
			{
				"name": "wolfbook_getNotebookContext",
				"displayName": "Wolfbook: Get Notebook Context",
				"toolReferenceName": "wolfbookContext",
				"modelDescription": "Returns a structured text representation of the currently open Wolfram Language notebook. Includes all cell sources (code and markdown), section headings, and cell outputs as LaTeX. Use this before writing or editing Wolfram Language code to understand what symbols are already defined, what has been computed, and what the mathematical goal of the notebook is.",
				"canBeReferencedInPrompt": true,
				"inputSchema": {
					"type": "object",
					"properties": {}
				}
			},
			{
				"name": "wolfbook_evaluateExpression",
				"displayName": "Wolfbook: Evaluate Expression",
				"toolReferenceName": "wolfbookEval",
				"modelDescription": "Evaluates a Wolfram Language expression in the active notebook's live kernel and returns the result as LaTeX or InputForm text. Use this to verify that an expression simplifies correctly, check that a residual is zero, or explore the output of a function before inserting code into the notebook. Do not use for long-running computations.",
				"canBeReferencedInPrompt": true,
				"inputSchema": {
					"type": "object",
					"properties": {
						"expression": {
							"type": "string",
							"description": "A valid Wolfram Language expression to evaluate."
						},
						"timeoutSeconds": {
							"type": "number",
							"description": "Maximum seconds to wait for result (default: 10)."
						}
					},
					"required": [
						"expression"
					]
				}
			},
			{
				"name": "wolfbook_lookupSymbol",
				"displayName": "Wolfbook: Lookup Symbol",
				"toolReferenceName": "wolfbookLookup",
				"modelDescription": "Returns the usage message and definition for a Wolfram Language symbol. Use this when unsure about the syntax or behaviour of a built-in function, or to understand a user-defined function in the notebook before using it.",
				"canBeReferencedInPrompt": true,
				"inputSchema": {
					"type": "object",
					"properties": {
						"symbol": {
							"type": "string",
							"description": "The name of the Wolfram Language symbol to look up (e.g. 'BBrel', 'Solve', 'Signature')."
						},
						"longForm": {
							"type": "boolean",
							"description": "If true (default), appends a clickable link to the online Wolfram documentation page at the bottom of the result. Only applies to built-in System-context symbols."
						}
					},
					"required": [
						"symbol"
					]
				}
			},
			{
				"name": "wolfbook_getSymbolWebHelp",
				"displayName": "Wolfbook: Get Symbol Web Help",
				"toolReferenceName": "wolfbookWebHelp",
				"modelDescription": "Fetches the full online Wolfram Language documentation page for a built-in symbol from reference.wolfram.com and returns its text content. Use this when you need detailed examples, complete option descriptions, or behaviour details beyond what wolfbook_lookupSymbol provides. Only works for System-context (built-in) symbols.",
				"canBeReferencedInPrompt": true,
				"inputSchema": {
					"type": "object",
					"properties": {
						"symbol": {
							"type": "string",
							"description": "The name of the Wolfram Language built-in symbol (e.g. 'FindRoot', 'NIntegrate', 'Plot')."
						}
					},
					"required": [
						"symbol"
					]
				}
			},
			{
				"name": "wolfbook_insertCell",
				"displayName": "Wolfbook: Insert Cell",
				"toolReferenceName": "wolfbookInsert",
				"modelDescription": "Inserts a new cell into the active Wolfram Language notebook at a specified position. Use this when the user asks you to add a computation, a check, or a documentation cell to the notebook. Always confirm the content with the user before inserting.",
				"canBeReferencedInPrompt": true,
				"inputSchema": {
					"type": "object",
					"properties": {
						"position": {
							"description": "Where to insert: 'after-cursor' inserts after the currently selected cell, 'end' appends at the end, or a zero-based cell index.",
							"oneOf": [
								{
									"type": "string",
									"enum": [
										"after-cursor",
										"end"
									]
								},
								{
									"type": "number"
								}
							]
						},
						"kind": {
							"type": "string",
							"enum": [
								"code",
								"markdown"
							],
							"description": "Cell type."
						},
						"content": {
							"type": "string",
							"description": "The cell source text."
						}
					},
					"required": [
						"position",
						"kind",
						"content"
					]
				}
			}
		],
		"configurationDefaults": {
			"[wolfram]": {
				"github.copilot.enable": {
					"*": true
				},
				"github.copilot.advanced": {
					"debug.overrideEngine": "gpt-4"
				},
				"editor.wordBasedSuggestions": "off",
				"editor.quickSuggestions": {
					"other": true,
					"comments": false,
					"strings": false
